# Copy to .env (untracked) and fill in values. docker compose reads .env.
# Inside the compose network the hosts are "db" and "cache"; when running
# the app on the host, use localhost instead.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=postgres://ledgerly:<POSTGRES_PASSWORD>@db:5432/ledgerly
REDIS_URL=redis://:<REDIS_PASSWORD>@cache:6379
PORT=3000
