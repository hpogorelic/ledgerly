# Copy to .env.test (untracked) and fill in the passwords, then run `npm run test:env`.
# The test suite runs TRUNCATE and FLUSHDB, so point it at a separate test
# database (ledgerly_test) and a separate Redis DB index (/1), never at the
# data you use for development. Start the stores first: docker compose up db cache
DATABASE_URL=postgres://ledgerly:<POSTGRES_PASSWORD>@localhost:5432/ledgerly_test
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/1
