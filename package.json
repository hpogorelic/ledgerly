{
  "name": "ledgerly",
  "version": "0.4.0",
  "private": true,
  "description": "small ledger api",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "lint": "eslint .",
    "test": "node --test",
    "test:env": "node --env-file=.env.test --test"
  },
  "dependencies": {
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "ioredis": "4.28.5",
    "pg": "8.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
